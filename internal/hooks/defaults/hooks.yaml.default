# File: hooks.yaml.default
# Description: Phase D 기본 hook 정책. 세션 시작 시 ~/.infractl/hooks.yaml 이 없으면 이 파일이 복사된다.
# Responsibility: Bash 계열 도구에 대해 fast-path 결정론 차단 + LLM validator 2 단 체인.
#
# 커스터마이즈: ~/.infractl/hooks.yaml 을 직접 편집하면 재시작 후 반영된다.
# 주의: 파일 권한이 group/world writable 이면 보안상 로드가 거부된다. (umask 022 권장)

PreToolUse:
  - matcher: "bash"
    hooks:
      # 1) 결정론 fast-path — 명백한 시스템 파괴 명령을 즉시 차단.
      - type: command
        command: "~/.infractl/builtins/system_risk.sh"
        timeout: 5
      # 2) LLM 위임 — 위 fast-path 를 통과한 명령을 Fast tier 로 종합 검증.
      - type: prompt
        prompt: "$BUILTIN:shell_validator"
        tier: fast
        timeout: 90

  - matcher: "shell_exec"
    hooks:
      - type: command
        command: "~/.infractl/builtins/system_risk.sh"
        timeout: 5
      - type: prompt
        prompt: "$BUILTIN:shell_validator"
        tier: fast
        timeout: 90

PostToolUse: []
SessionStart: []
SessionEnd: []
