	// --- SectionServers ---
	if sections.Has(SectionServers) && len(servers) > 0 {
		sb.WriteString("## Known Servers Pool (SSH Targets)\n")
		sb.WriteString("These are registered SSH servers ??i.e., machines you can connect to.\n")
